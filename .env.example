# Provider selection
AI_PROVIDER=openai

# Application state / runtime
STATE_PATH=data/learner.db
MAX_HISTORY_MESSAGES=24
QUALITY_GATE=false
RESEARCH_ENABLED=false
LOCAL_KNOWLEDGE_PATH=data/knowledge
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
# Comma-separated origins; leave empty for same-origin only.
CORS_ORIGINS=

# Set exactly the credentials/model for the active provider.
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=
